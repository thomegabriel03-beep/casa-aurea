# ---------------------------------------------------------------
# Casa Áurea — variáveis de ambiente (copie para .env.local)
# ---------------------------------------------------------------

# URL pública do site (canonical, sitemap, OpenGraph e link enviado no WhatsApp)
NEXT_PUBLIC_SITE_URL=https://www.casaaurea.com.br

# WhatsApp comercial — somente dígitos, com DDI e DDD
NEXT_PUBLIC_WHATSAPP_NUMBER=5548984576227

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente para scripts locais (seed/importação em lote). NUNCA expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Analytics (opcionais)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Exibe marcações de conteúdo pendente no site (true em aprovação, false em produção)
NEXT_PUBLIC_SHOW_PENDING=false
